      "nessa-chart-series-2-strong": "oklch(0.66 0.1 45)",
      "nessa-chart-series-3": "oklch(0.3634 0.062 190)",
      "nessa-chart-series-3-strong": "oklch(0.6 0.1 190)",
      "nessa-chart-series-4": "oklch(0.421 0.07 85)",

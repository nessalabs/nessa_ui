  "css": {
    ":where(:root, [data-nessa-root])": {
      "--_nessa-scale-factor": "1"
    },
    ":where([data-nessa-scale=\"90\"])": {
      "--_nessa-scale-factor": "0.9"
    },
    ":where([data-nessa-scale=\"95\"])": {
      "--_nessa-scale-factor": "0.95"
    },
    ":where([data-nessa-scale=\"100\"])": {
      "--_nessa-scale-factor": "1"
    },
    ":where([data-nessa-scale=\"105\"])": {
      "--_nessa-scale-factor": "1.05"
    },
    ":where([data-nessa-scale=\"110\"])": {
      "--_nessa-scale-factor": "1.1"
    },
    ":where([data-nessa-scale=\"125\"])": {
      "--_nessa-scale-factor": "1.25"
    },
    ":where(:root, [data-nessa-root], [data-nessa-theme], [data-nessa-scale])": {
      "--_nessa-font-size-1": "calc(var(--nessa-font-size-1) * var(--_nessa-scale-factor))",
      "--_nessa-font-size-2": "calc(var(--nessa-font-size-2) * var(--_nessa-scale-factor))",
      "--_nessa-font-size-3": "calc(var(--nessa-font-size-3) * var(--_nessa-scale-factor))",
      "--_nessa-font-size-4": "calc(var(--nessa-font-size-4) * var(--_nessa-scale-factor))",
      "--_nessa-font-size-5": "calc(var(--nessa-font-size-5) * var(--_nessa-scale-factor))",
      "--_nessa-font-size-6": "calc(var(--nessa-font-size-6) * var(--_nessa-scale-factor))",
      "--_nessa-font-size-7": "calc(var(--nessa-font-size-7) * var(--_nessa-scale-factor))",
      "--_nessa-line-height-1": "var(--nessa-line-height-1)",
      "--_nessa-line-height-2": "var(--nessa-line-height-2)",
      "--_nessa-line-height-3": "var(--nessa-line-height-3)",
      "--_nessa-line-height-4": "var(--nessa-line-height-4)",
      "--_nessa-line-height-5": "var(--nessa-line-height-5)",
      "--_nessa-line-height-6": "var(--nessa-line-height-6)",
      "--_nessa-line-height-7": "var(--nessa-line-height-7)",
      "--_nessa-letter-spacing-1": "var(--nessa-letter-spacing-1)",
      "--_nessa-letter-spacing-2": "var(--nessa-letter-spacing-2)",
      "--_nessa-letter-spacing-3": "var(--nessa-letter-spacing-3)",
      "--_nessa-letter-spacing-4": "var(--nessa-letter-spacing-4)",
      "--_nessa-letter-spacing-5": "var(--nessa-letter-spacing-5)",
      "--_nessa-letter-spacing-6": "var(--nessa-letter-spacing-6)",
      "--_nessa-letter-spacing-7": "var(--nessa-letter-spacing-7)"
    },
    ":root, :where([data-nessa-root], [data-nessa-theme], [data-nessa-scale])": {
      "--spacing": "calc(0.25rem * var(--_nessa-scale-factor))"
    },
    "@layer components": {
      ".nessa-text-1": {
        "font-size": "var(--_nessa-font-size-1)",
        "line-height": "var(--_nessa-line-height-1)",
        "letter-spacing": "var(--_nessa-letter-spacing-1)"
      },
      ".nessa-text-2": {
        "font-size": "var(--_nessa-font-size-2)",
        "line-height": "var(--_nessa-line-height-2)",
        "letter-spacing": "var(--_nessa-letter-spacing-2)"
      },
      ".nessa-text-3": {
        "font-size": "var(--_nessa-font-size-3)",
        "line-height": "var(--_nessa-line-height-3)",
        "letter-spacing": "var(--_nessa-letter-spacing-3)"
      },
      ".nessa-text-4": {
        "font-size": "var(--_nessa-font-size-4)",
        "line-height": "var(--_nessa-line-height-4)",
        "letter-spacing": "var(--_nessa-letter-spacing-4)"
      },
      ".nessa-text-5": {
        "font-size": "var(--_nessa-font-size-5)",
        "line-height": "var(--_nessa-line-height-5)",
        "letter-spacing": "var(--_nessa-letter-spacing-5)"
      },
      ".nessa-text-6": {
        "font-size": "var(--_nessa-font-size-6)",
        "line-height": "var(--_nessa-line-height-6)",
        "letter-spacing": "var(--_nessa-letter-spacing-6)"
      },
      ".nessa-text-7": {
        "font-size": "var(--_nessa-font-size-7)",
        "line-height": "var(--_nessa-line-height-7)",
        "letter-spacing": "var(--_nessa-letter-spacing-7)"
      },
      ".nessa-text-input": {
        "font-size": "max(1rem, var(--_nessa-font-size-4))",
        "line-height": "var(--_nessa-line-height-4)",
        "letter-spacing": "var(--_nessa-letter-spacing-4)"
      },
      ".nessa-text-input-2": {
        "font-size": "max(1rem, var(--_nessa-font-size-2))",
        "line-height": "var(--_nessa-line-height-2)",
        "letter-spacing": "var(--_nessa-letter-spacing-2)"
      },
      "@media (width >= 48rem)": {
        ".nessa-text-input": {
          "font-size": "var(--_nessa-font-size-4)"
        },
        ".nessa-text-input-2": {
          "font-size": "var(--_nessa-font-size-2)"
        }
      }
    },
    "@media (prefers-reduced-motion: reduce)": {
      ":root, :where([data-nessa-root], [data-nessa-theme], [data-nessa-scale])": {
        "--nessa-motion-duration-fast": "0ms",
        "--nessa-motion-duration-normal": "0ms",
        "--nessa-motion-duration-slow": "0ms",
        "--nessa-motion-duration-ambient": "0ms"
      }
    }
  },
  "type": "registry:base",
  "config": {
    "style": "new-york",
    "rsc": false,
    "tsx": true,
    "tailwind": {
      "baseColor": "zinc",
      "cssVariables": true
    },
    "iconLibrary": "lucide"
  }
}
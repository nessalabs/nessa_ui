{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "nessa-base",
  "title": "Nessa UI base",
  "description": "The Nessa UI foundation: Radix primitives, semantic color tokens, font stacks, and radius.",
  "dependencies": [
    "class-variance-authority",
    "clsx",
    "lucide-react",
    "radix-ui",
    "tailwind-merge"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "\"Geist Variable\", \"Geist\", ui-sans-serif, system-ui, sans-serif",
      "font-mono": "\"Geist Mono Variable\", \"Geist Mono\", ui-monospace, monospace",
      "radius": "0.625rem"
    },
    "light": {
      "background": "oklch(0.985 0.006 255)",
      "foreground": "oklch(0.205 0.025 258)",
      "card": "oklch(1 0 0)",
      "card-foreground": "oklch(0.205 0.025 258)",
      "popover": "oklch(1 0 0)",
      "popover-foreground": "oklch(0.205 0.025 258)",
      "primary": "oklch(0.205 0 0)",
      "primary-foreground": "oklch(0.985 0 0)",
      "secondary": "oklch(0.94 0.018 255)",
      "secondary-foreground": "oklch(0.27 0.04 258)",
      "muted": "oklch(0.95 0.012 255)",
      "muted-foreground": "oklch(0.49 0.035 258)",
      "accent": "oklch(0.925 0.035 255)",
      "accent-foreground": "oklch(0.27 0.07 258)",
      "destructive": "oklch(0.58 0.22 27)",
      "destructive-foreground": "oklch(0.985 0.006 255)",
      "border": "oklch(0.885 0.018 255)",
      "input": "oklch(0.86 0.022 255)",
      "ring": "oklch(0.556 0 0)"
    },
    "dark": {
      "background": "oklch(0.155 0.025 258)",
      "foreground": "oklch(0.96 0.01 255)",
      "card": "oklch(0.195 0.03 258)",
      "card-foreground": "oklch(0.96 0.01 255)",
      "popover": "oklch(0.195 0.03 258)",
      "popover-foreground": "oklch(0.96 0.01 255)",
      "primary": "oklch(0.922 0 0)",
      "primary-foreground": "oklch(0.205 0 0)",
      "secondary": "oklch(0.255 0.035 258)",
      "secondary-foreground": "oklch(0.94 0.012 255)",
      "muted": "oklch(0.245 0.025 258)",
      "muted-foreground": "oklch(0.7 0.035 255)",
      "accent": "oklch(0.29 0.06 258)",
      "accent-foreground": "oklch(0.95 0.015 255)",
      "destructive": "oklch(0.69 0.19 25)",
      "destructive-foreground": "oklch(0.17 0.035 258)",
      "border": "oklch(1 0 0 / 12%)",
      "input": "oklch(1 0 0 / 16%)",
      "ring": "oklch(0.708 0 0)"
    }
  },
  "type": "registry:base",
  "config": {
    "style": "new-york",
    "rsc": false,
    "tsx": true,
    "tailwind": {
      "baseColor": "zinc",
      "cssVariables": true
    },
    "iconLibrary": "lucide"
  }
}
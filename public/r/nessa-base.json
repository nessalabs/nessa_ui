{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "nessa-base",
  "title": "Nessa UI base",
  "description": "The Nessa UI foundation: Radix primitives, semantic color tokens, font stacks, and radius.",
  "dependencies": [
    "class-variance-authority",
    "clsx",
    "lucide-react",
    "radix-ui",
    "tailwind-merge"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "\"Geist Variable\", \"Geist\", ui-sans-serif, system-ui, sans-serif",
      "font-mono": "\"Geist Mono Variable\", \"Geist Mono\", ui-monospace, monospace",
      "nessa-motion-duration-instant": "0ms",
      "nessa-motion-duration-fast": "120ms",
      "nessa-motion-duration-normal": "200ms",
      "nessa-motion-duration-slow": "300ms",
      "nessa-motion-duration-ambient": "3.2s",
      "nessa-motion-easing-standard": "cubic-bezier(0.2, 0, 0, 1)",
      "nessa-motion-easing-emphasized": "cubic-bezier(0.4, 0, 0.2, 1)",
      "radius": "0.625rem"
    },
    "light": {
      "background": "oklch(1 0 0)",
      "foreground": "oklch(0.145 0 0)",
      "card": "oklch(1 0 0)",
      "card-foreground": "oklch(0.145 0 0)",
      "popover": "oklch(1 0 0)",
      "popover-foreground": "oklch(0.145 0 0)",
      "primary": "oklch(0.205 0 0)",
      "primary-foreground": "oklch(0.985 0 0)",
      "secondary": "oklch(0.97 0 0)",
      "secondary-foreground": "oklch(0.205 0 0)",
      "muted": "oklch(0.97 0 0)",
      "muted-foreground": "oklch(0.52 0 0)",
      "accent": "oklch(0.97 0 0)",
      "accent-foreground": "oklch(0.205 0 0)",
      "destructive": "oklch(0.577 0.235 27.325)",
      "destructive-foreground": "oklch(0.985 0 0)",
      "border": "oklch(0.922 0 0)",
      "input": "oklch(0.922 0 0)",
      "ring": "oklch(0.556 0 0)",
      "sidebar": "oklch(0.985 0 0)",
      "sidebar-foreground": "oklch(0.141 0.005 285.823)",
      "sidebar-accent": "oklch(0.97 0 0)",
      "sidebar-accent-foreground": "oklch(0.205 0 0)",
      "sidebar-border": "oklch(0.922 0 0)",
      "sidebar-ring": "oklch(0.556 0 0)",
      "nessa-font-size-1": "0.6875rem",
      "nessa-font-size-2": "0.75rem",
      "nessa-font-size-3": "0.8125rem",
      "nessa-font-size-4": "0.875rem",
      "nessa-font-size-5": "1rem",
      "nessa-font-size-6": "1.125rem",
      "nessa-font-size-7": "1.25rem",
      "nessa-line-height-1": "1.454545",
      "nessa-line-height-2": "1.333333",
      "nessa-line-height-3": "1.538462",
      "nessa-line-height-4": "1.428571",
      "nessa-line-height-5": "1.5",
      "nessa-line-height-6": "1.555556",
      "nessa-line-height-7": "1.4",
      "nessa-letter-spacing-1": "0em",
      "nessa-letter-spacing-2": "0em",
      "nessa-letter-spacing-3": "0em",
      "nessa-letter-spacing-4": "0em",
      "nessa-letter-spacing-5": "0em",
      "nessa-letter-spacing-6": "0em",
      "nessa-letter-spacing-7": "0em",
      "nessa-motion-duration-instant": "0ms",
      "nessa-motion-duration-fast": "120ms",
      "nessa-motion-duration-normal": "200ms",
      "nessa-motion-duration-slow": "300ms",
      "nessa-motion-duration-ambient": "3.2s",
      "nessa-motion-easing-standard": "cubic-bezier(0.2, 0, 0, 1)",
      "nessa-motion-easing-emphasized": "cubic-bezier(0.4, 0, 0.2, 1)",
      "nessa-thinking-fill-base": "oklch(0.56 0.2 265)",
      "nessa-thinking-fill-current": "oklch(0.68 0.2 304)",
      "nessa-thinking-fill-highlight": "oklch(0.86 0.11 214)",
      "nessa-fast-mode-active": "oklch(0.57 0.22 300)",
      "nessa-diff-addition": "oklch(0.5 0.137 150)",
      "nessa-diff-deletion": "oklch(0.55 0.19 27)"
    },
    "dark": {
      "background": "oklch(0.145 0 0)",
      "foreground": "oklch(0.985 0 0)",
      "card": "oklch(0.205 0 0)",
      "card-foreground": "oklch(0.985 0 0)",
      "popover": "oklch(0.205 0 0)",
      "popover-foreground": "oklch(0.985 0 0)",
      "primary": "oklch(0.922 0 0)",
      "primary-foreground": "oklch(0.205 0 0)",
      "secondary": "oklch(0.269 0 0)",
      "secondary-foreground": "oklch(0.985 0 0)",
      "muted": "oklch(0.269 0 0)",
      "muted-foreground": "oklch(0.708 0 0)",
      "accent": "oklch(0.269 0 0)",
      "accent-foreground": "oklch(0.985 0 0)",
      "destructive": "oklch(0.704 0.187 22.216)",
      "destructive-foreground": "oklch(0.145 0 0)",
      "border": "oklch(1 0 0 / 12%)",
      "input": "oklch(1 0 0 / 15%)",
      "ring": "oklch(0.708 0 0)",
      "sidebar": "oklch(0.141 0.005 285.823)",
      "sidebar-foreground": "oklch(0.985 0 0)",
      "sidebar-accent": "oklch(0.274 0.006 286.033)",
      "sidebar-accent-foreground": "oklch(0.985 0 0)",
      "sidebar-border": "oklch(0.274 0.006 286.033)",
      "sidebar-ring": "oklch(0.708 0 0)",
      "nessa-thinking-fill-base": "oklch(0.54 0.19 264)",
      "nessa-thinking-fill-current": "oklch(0.67 0.2 306)",
      "nessa-thinking-fill-highlight": "oklch(0.82 0.12 210)",
      "nessa-fast-mode-active": "oklch(0.72 0.185 306)",
      "nessa-diff-addition": "oklch(0.77 0.17 152)",
      "nessa-diff-deletion": "oklch(0.7 0.19 25)"
    }
  },
  "css": {
    ":where(:root, [data-nessa-root])": {
      "--_nessa-scale-factor": "1"
    },
    ":where([data-nessa-scale=\"90\"])": {
      "--_nessa-scale-factor": "0.9"
    },
    ":where([data-nessa-scale=\"95\"])": {
      "--_nessa-scale-factor": "0.95"
    },
    ":where([data-nessa-scale=\"100\"])": {
      "--_nessa-scale-factor": "1"
    },
    ":where([data-nessa-scale=\"105\"])": {
      "--_nessa-scale-factor": "1.05"
    },
    ":where([data-nessa-scale=\"110\"])": {
      "--_nessa-scale-factor": "1.1"
    },
    ":where(:root, [data-nessa-root], [data-nessa-theme], [data-nessa-scale])": {
      "--_nessa-font-size-1": "calc(var(--nessa-font-size-1) * var(--_nessa-scale-factor))",
      "--_nessa-font-size-2": "calc(var(--nessa-font-size-2) * var(--_nessa-scale-factor))",
      "--_nessa-font-size-3": "calc(var(--nessa-font-size-3) * var(--_nessa-scale-factor))",
      "--_nessa-font-size-4": "calc(var(--nessa-font-size-4) * var(--_nessa-scale-factor))",
      "--_nessa-font-size-5": "calc(var(--nessa-font-size-5) * var(--_nessa-scale-factor))",
      "--_nessa-font-size-6": "calc(var(--nessa-font-size-6) * var(--_nessa-scale-factor))",
      "--_nessa-font-size-7": "calc(var(--nessa-font-size-7) * var(--_nessa-scale-factor))",
      "--_nessa-line-height-1": "var(--nessa-line-height-1)",
      "--_nessa-line-height-2": "var(--nessa-line-height-2)",
      "--_nessa-line-height-3": "var(--nessa-line-height-3)",
      "--_nessa-line-height-4": "var(--nessa-line-height-4)",
      "--_nessa-line-height-5": "var(--nessa-line-height-5)",
      "--_nessa-line-height-6": "var(--nessa-line-height-6)",
      "--_nessa-line-height-7": "var(--nessa-line-height-7)",
      "--_nessa-letter-spacing-1": "var(--nessa-letter-spacing-1)",
      "--_nessa-letter-spacing-2": "var(--nessa-letter-spacing-2)",
      "--_nessa-letter-spacing-3": "var(--nessa-letter-spacing-3)",
      "--_nessa-letter-spacing-4": "var(--nessa-letter-spacing-4)",
      "--_nessa-letter-spacing-5": "var(--nessa-letter-spacing-5)",
      "--_nessa-letter-spacing-6": "var(--nessa-letter-spacing-6)",
      "--_nessa-letter-spacing-7": "var(--nessa-letter-spacing-7)"
    },
    "@layer components": {
      ".nessa-text-1": {
        "font-size": "var(--_nessa-font-size-1)",
        "line-height": "var(--_nessa-line-height-1)",
        "letter-spacing": "var(--_nessa-letter-spacing-1)"
      },
      ".nessa-text-2": {
        "font-size": "var(--_nessa-font-size-2)",
        "line-height": "var(--_nessa-line-height-2)",
        "letter-spacing": "var(--_nessa-letter-spacing-2)"
      },
      ".nessa-text-3": {
        "font-size": "var(--_nessa-font-size-3)",
        "line-height": "var(--_nessa-line-height-3)",
        "letter-spacing": "var(--_nessa-letter-spacing-3)"
      },
      ".nessa-text-4": {
        "font-size": "var(--_nessa-font-size-4)",
        "line-height": "var(--_nessa-line-height-4)",
        "letter-spacing": "var(--_nessa-letter-spacing-4)"
      },
      ".nessa-text-5": {
        "font-size": "var(--_nessa-font-size-5)",
        "line-height": "var(--_nessa-line-height-5)",
        "letter-spacing": "var(--_nessa-letter-spacing-5)"
      },
      ".nessa-text-6": {
        "font-size": "var(--_nessa-font-size-6)",
        "line-height": "var(--_nessa-line-height-6)",
        "letter-spacing": "var(--_nessa-letter-spacing-6)"
      },
      ".nessa-text-7": {
        "font-size": "var(--_nessa-font-size-7)",
        "line-height": "var(--_nessa-line-height-7)",
        "letter-spacing": "var(--_nessa-letter-spacing-7)"
      },
      ".nessa-text-input": {
        "font-size": "max(1rem, var(--_nessa-font-size-4))",
        "line-height": "var(--_nessa-line-height-4)",
        "letter-spacing": "var(--_nessa-letter-spacing-4)"
      },
      "@media (width >= 48rem)": {
        ".nessa-text-input": {
          "font-size": "var(--_nessa-font-size-4)"
        }
      }
    },
    "@media (prefers-reduced-motion: reduce)": {
      ":root, :where([data-nessa-root], [data-nessa-theme], [data-nessa-scale])": {
        "--nessa-motion-duration-fast": "0ms",
        "--nessa-motion-duration-normal": "0ms",
        "--nessa-motion-duration-slow": "0ms",
        "--nessa-motion-duration-ambient": "0ms"
      }
    }
  },
  "type": "registry:base",
  "config": {
    "style": "new-york",
    "rsc": false,
    "tsx": true,
    "tailwind": {
      "baseColor": "zinc",
      "cssVariables": true
    },
    "iconLibrary": "lucide"
  }
}
{
  "name": "@nessa-ui/react",
  "version": "0.1.0",
  "description": "Accessible React components and tokens for Nessa products.",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm clean && tsup && tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "clean": "rimraf dist",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/cli": "^4.1.11",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.11",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nessalabs/nessa_ui.git",
    "directory": "packages/react"
  },
  "keywords": [
    "design-system",
    "react",
    "shadcn",
    "ui"
  ],
  "author": "nessalabs",
  "bugs": {
    "url": "https://github.com/nessalabs/nessa_ui/issues"
  },
  "homepage": "https://github.com/nessalabs/nessa_ui#readme"
}

  "items": [
    {
      "name": "nessa-base",
      "type": "registry:base",
      "title": "Nessa UI base",
      "description": "The Nessa UI foundation: Radix primitives, semantic color tokens, font stacks, and radius.",
      "config": {
        "style": "new-york",
        "rsc": false,
        "tsx": true,
        "iconLibrary": "lucide",
        "tailwind": {
          "baseColor": "zinc",
          "cssVariables": true
        }
      },
      "dependencies": [
        "class-variance-authority",
        "clsx",
        "lucide-react",
        "radix-ui",
        "tailwind-merge"
      ],
      "cssVars": {

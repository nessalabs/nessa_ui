          "sidebar-ring": "oklch(0.708 0 0)",
          "nessa-thinking-fill-base": "oklch(0.54 0.19 264)",
          "nessa-thinking-fill-current": "oklch(0.67 0.2 306)",
          "nessa-thinking-fill-highlight": "oklch(0.82 0.12 210)",
          "nessa-fast-mode-active": "oklch(0.72 0.19 306)"
        }
      },
      "css": {
        "@media (prefers-reduced-motion: reduce)": {
          ":root, :where([data-nessa-root], [data-nessa-theme], [data-nessa-scale])": {

          "sidebar-ring": "oklch(0.556 0 0)",
          "nessa-motion-duration-instant": "0ms",
          "nessa-motion-duration-fast": "120ms",
          "nessa-motion-duration-normal": "200ms",
          "nessa-motion-duration-slow": "300ms",
          "nessa-motion-duration-ambient": "3.2s",
          "nessa-motion-easing-standard": "cubic-bezier(0.2, 0, 0, 1)",
          "nessa-motion-easing-emphasized": "cubic-bezier(0.4, 0, 0.2, 1)",
          "nessa-thinking-fill-base": "oklch(0.56 0.2 265)",
          "nessa-thinking-fill-current": "oklch(0.68 0.2 304)",
          "nessa-thinking-fill-highlight": "oklch(0.86 0.11 214)",
          "nessa-fast-mode-active": "oklch(0.57 0.22 300)"
        },
        "dark": {
          "background": "oklch(0.155 0.025 258)",
          "foreground": "oklch(0.96 0.01 255)",
